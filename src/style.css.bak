@import './themes/index.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    font-family: 'Noto Sans TC', sans-serif;
    user-select: none;
    -webkit-user-select: none;
  }
  input, textarea, [contenteditable] {
    user-select: text;
    -webkit-user-select: text;
  }
  button {
    outline: none !important;
  }
  button:focus {
    outline: none !important;
  }
}

@layer utilities {
  .canvas-bg {
    background-color: #fbfbfb;
    background-image: linear-gradient(to right, #e5e7eb 1px, transparent 1px), linear-gradient(to bottom, #e5e7eb 1px, transparent 1px);
    background-size: 20px 20px;
  }
  
  .sketch {
    border: 2px solid #334155;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    background-color: white;
    transition: all 0.2s ease;
  }
  .sketch:hover {
    border-radius: 15px 255px 15px 225px/225px 15px 255px 15px;
  }
  .sketch-panel {
    border: 2px solid #334155;
    border-radius: 15px 225px 15px 255px/255px 15px 225px 15px;
    background-color: transparent;
  }
  .sketch-btn {
    border: 1.5px solid #334155;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    box-shadow: 2px 2px 0px rgba(51, 65, 85, 0.15);
    background-color: white;
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .sketch-btn:hover {
    box-shadow: 3px 3px 0px rgba(51, 65, 85, 0.25);
    transform: translateY(-1px);
  }
  .sketch-btn-disabled {
    border: 1.5px solid #94a3b8;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    background-color: #f8fafc;
    color: #94a3b8;
    cursor: not-allowed;
    opacity: 0.7;
  }
  .sketch-header-group {
    border: 1.5px solid #334155;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    padding: 2px;
    display: inline-flex;
    background: white;
  }
  
  .sketch-tooltip {
    position: absolute;
    background-color: #1e293b;
    color: #f8fafc;
    border: 2px solid #0f172a;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    padding: 6px 12px;
    font-size: 0.85rem;
    font-weight: 500;
    pointer-events: none;
    z-index: 10000;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    width: max-content;
    max-width: 300px;
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.3);
  }
  .sketch-tooltip.show {
    opacity: 1;
    transform: translateY(0);
  }
  
  .context-helper {
    border: 2px solid #334155;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    background-color: #ffffff;
    box-shadow: 3px 3px 0px rgba(51, 65, 85, 0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
}

/* Custom Scrollbar */
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}
.custom-scrollbar::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

@keyframes scaleIn {
  0% {
    opacity: 0;
    transform: scale(0.95);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.animate-scale-in {
  animation: scaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* No Scrollbar Utility for smooth header scrolling */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Sidebar Collapse Transitions */
.sidebar-collapsible {
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}
.sidebar-collapsible.is-collapsed {
  width: 0px !important;
  min-width: 0px !important;
  border-left-width: 0px !important;
  border-right-width: 0px !important;
  padding: 0px !important;
}
.sidebar-collapsible.is-collapsed > div {
  opacity: 0;
  pointer-events: none;
  overflow: hidden;
  width: 0 !important;
  min-width: 0 !important;
}
.sidebar-toggle-handle {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 50;
  pointer-events: auto !important;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
.sidebar-toggle-handle:hover {
  transform: translateY(-50%) scale(1.08);
}
